.venv/
.env
env/
venv/

# Generated artefacts (heavy / regeneratable; tracked separately if needed)
outputs/anndata/*.h5ad
outputs/anndata/*.npy
outputs/anndata/*.npz
outputs/coupling/
outputs/figures/
# logs: ignore the dir's contents EXCEPT the small result files, which we commit
# so a fresh clone can read every headline number without downloading the data.
outputs/logs/*
!outputs/logs/*.json
!outputs/logs/*.csv
outputs/comparison/
outputs/viewer/
outputs/gui/

# External data downloads (large; regeneratable from pipeline/00_external/)
data_external/

# Allen ISH download cache from Pagani gene-expansion experiment
# (~600 MB of raw zips; the per-parcel matrix `pagani_mouse_expr.npy` IS
#  tracked because it's small and lets downstream users skip the 1-3 day
#  Allen API download)
experiments/autism_subtypes/allen_expansion/pagani_ish_cache/

# ABIDE / nilearn cache (lives in user $HOME/abide_cache by default;
# allowlist here in case someone puts it in-tree)
abide_cache/
*.1D

# Internal development artifacts (kept local; not pushed publicly)
ROADMAP.md
docs/dev/

# Obsolete research scripts (results documented in docs/results.md for
# context; the scripts themselves aren't part of the public package)
experiments/archive/

# Scratch / debugging artefacts
.scratch/
nb_runs/
*.log

# Dated audit reports (rebuild on demand if needed)
docs/audit_*.md

# Split-half FC caches (58 MB; rebuild with pipeline/02b_build_splithalf_fc.py)
outputs/splithalf/

# neuromaps download cache (~110 MB; refetched by reverse_translation/00_fetch_maps.py)
experiments/reverse_translation/neuromaps_cache/

# Review-round scratch; the analyses have been ported into experiments/
_review_scratch/

# ABIDE phenotypic data: per-subject clinical detail, not ours to redistribute
outputs/logs/abide_per_subject_scores.csv

# resume state for experiments/section2_supervision/05_heldout_three_config.py
outputs/logs/.05_heldout_progress.json

# Local authoring tools and drafts. Kept out of the release: these serve the write-up
# rather than reproducing an analysis.
tools/check_manuscript_numbers.py
tools/check_prose_style.py
tools/patch_readme.py
tools/audit_pi.py
experiments/REVIEW_ROUND.md
experiments/reverse_translation/SECTION_DRAFT.md

# Output of the local pi-audit tool, which scans paths outside this repository.
outputs/audit/

# Development history: iteration log, pre-pack diagnostics, superseded summaries.
# Kept locally, not part of the release.
docs/archive/

# Correspondence and dated internal validation notes.
experiments/**/email_draft_*.md
experiments/**/DATA_VALIDATION_*.md

# ABIDE-derived results. The data are redistributable only from the 1000 Functional
# Connectomes Project after registration, so only the analysis scripts are released.
outputs/logs/abide_*
outputs/logs/out_abide_*
outputs/logs/autism_subtypes_abide.json

# Solver characterisation kept locally, not part of the release.
outputs/logs/solver_scale_invariance.json
outputs/logs/pi_canonical_iter1000_*.json
