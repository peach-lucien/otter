# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/

# Jupyter
.ipynb_checkpoints/

# Test / lint caches
.pytest_cache/
pytest-of-*/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Editors / OS
.DS_Store
.vscode/
.idea/

